# Copy to .env.local and fill in secrets. The app boots without OpenAI/TMDB keys
# and shows clear errors for ingest / recommend / voice.

# --- Required for ingest, posters, Home recs, Room STT/extract/TTS ---
OPENAI_API_KEY=
TMDB_API_KEY=

# Optional model overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Ingest size (20 titles per TMDB page). Default 10 pages each of movies + TV.
TMDB_INGEST_PAGES=10

# Optional: extra Next.js allowedDevOrigins (tunnels). LAN IPv4 is allowed automatically.
# ALLOWED_DEV_ORIGIN=my-tunnel.example.com

# --- Supabase ---
# Local (`npx supabase start`) or hosted. Do not keep both URL/key pairs uncommented.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias for ANON_KEY.
# SUPABASE_SECRET_KEY is accepted as an alias for SERVICE_ROLE_KEY (needed for ingest).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# SUPABASE_SECRET_KEY=
